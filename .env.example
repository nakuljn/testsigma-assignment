# Model provider: openai or anthropic
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Model names (optional overrides)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Search provider: tavily or duckduckgo
SEARCH_PROVIDER=duckduckgo

# Set to 1 to skip web search (faster demos; use: make demo FAST=1)
SKIP_WEB_SEARCH=0
# Set to 1 with SKIP_WEB_SEARCH for batched LLM (~5 API calls total)
BATCH_LLM=0
SEARCH_TIMEOUT_SECONDS=15
MAX_PRICING_WEB_SEARCHES=3

# Tavily (only needed if SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=tvly-...

# Policy thresholds (optional overrides)
MIN_MARGIN_PCT=0.20
DAYS_COVER_CRITICAL=3
DAYS_COVER_LOW=7
LOW_SALES_QUARTILE=0.25
